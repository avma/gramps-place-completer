# Place Completer: Hebrew. A text left with an empty msgstr is shown in English.
msgid ""
msgstr ""
"Language: he\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Place Completer"
msgstr "השלמת מדרג מקומות"

msgid "_Close"
msgstr "_סגירה"

msgid "Enter the API key for the selected AI once: it will be saved securely"
msgstr ""
"הזנת מפתח ‪API‬ של הבינה המלאכותית שנבחרה, פעם אחת: המפתח יישמר באופן מאובטח"

msgid "_Cancel"
msgstr "_ביטול"

msgid "_OK"
msgstr "_בסדר"

msgid "The response is ready. Looking up coordinates on Wikidata…"
msgstr "התשובה מוכנה. חיפוש נקודות־ציון ב־‪Wikidata‬…"

msgid "Remove"
msgstr "הסרה"

msgid "Test"
msgstr "בדיקה"

msgid "Save"
msgstr "שמירה"

msgid "paste the key here"
msgstr "הדבקת המפתח כאן"

msgid "Sent only to %s."
msgstr "נשלח אל ‪%s‬ בלבד."

msgid "Ask"
msgstr "שליחה"

msgid "Key…"
msgstr "מפתח…"

msgid "Look up coordinates on Wikidata (only place names are sent)"
msgstr "חיפוש נקודות־ציון ב־‪Wikidata‬ (נשלחים שמות המקומות בלבד)"

msgid "Which place is this?"
msgstr "איזה מקום זה?"

msgid "Cancelled: no place selected."
msgstr "בוטל: לא נבחר מקום."

msgid "API key"
msgstr "מפתח ‪API‬"

msgid "This family tree is opened as read-only."
msgstr "אילן־היוחסין הזה נפתח לקריאה בלבד."

msgid "Select at least one proposed change first."
msgstr "יש לבחור תחילה שינוי מוצע אחד לפחות."

msgid "Place"
msgstr "מקום"

msgid "Date"
msgstr "תאריך"

msgid "Region hint"
msgstr "רמז אזור"

msgid "AI"
msgstr "בינה מלאכותית"

msgid "Question"
msgstr "שאלה"

msgid "Paste from clipboard"
msgstr "הדבקה מלוח־גזירים"

msgid "Analyze"
msgstr "ניתוח"

msgid "Level"
msgstr "רמה"

msgid ""
"The response specifies «%(name)s» (%(type)s), matching several existing "
"places in your tree. No changes will be made until you choose one."
msgstr ""
"התשובה מציינת את «%(name)s» (%(type)s), והיא מתאימה לכמה מקומות קיימים "
"באילן־היוחסין. שום שינוי לא ייעשה עד לבחירת אחד מהם."

msgid "Exclude this level"
msgstr "הוצאת הרמה הזו"

msgid "Could not query Wikidata: %s"
msgstr "לא ניתן היה לפנות אל ‪Wikidata‬: %s"

msgid "This name matches multiple places. Which one did you mean?"
msgstr "השם הזה מתאים לכמה מקומות. לאיזה מהם הכוונה?"

msgid "%s does not require an API key."
msgstr "%s אינו דורש מפתח ‪API‬."

msgid "No API key saved for this AI engine yet."
msgstr "עדיין לא נשמר מפתח ‪API‬ למנוע הבינה המלאכותית הזה."

msgid "Testing API key connection…"
msgstr "בדיקת החיבור עם מפתח ‪API‬…"

msgid "Key saved. Finding an available model…"
msgstr "המפתח נשמר. חיפוש מודל זמין…"

msgid "Key saved, but could not select a model: %s"
msgstr "המפתח נשמר, אך לא ניתן היה לבחור מודל: %s"

msgid "Key saved; model %s was automatically selected."
msgstr "המפתח נשמר; המודל %s נבחר אוטומטית."

msgid ""
"could not select a model from %s (%s). Specify a target model in %s, e.g.: "
"{\"engines\": {\"%s\": {\"model\": \"model-name\"}}}"
msgstr ""
"לא ניתן היה לבחור מודל מתוך ‪%s‬ (%s). יש לציין מודל יעד ב־‪%s‬, לדוגמה: "
"‪{\"engines\": {\"%s\": {\"model\": \"model-name\"}}}‬"

msgid "none"
msgstr "אין"

msgid ""
"model %s is no longer offered by host (%s); model choice will re-evaluate on"
" next request"
msgstr ""
"המודל %s כבר אינו מוצע על ידי המארח (%s); בחירת המודל תיבדק מחדש בבקשה הבאה"

msgid "model selected automatically"
msgstr "המודל נבחר אוטומטית"

msgid "API key saved, but service is unavailable: %s"
msgstr "מפתח ‪API‬ נשמר, אך השירות אינו זמין: %s"

msgid "Key saved (%s)."
msgstr "המפתח נשמר (%s)."

msgid "Apply %d change(s) to the family tree?"
msgstr "להחיל %d שינויים על אילן־היוחסין?"

msgid "New place «%s»"
msgstr "מקום חדש «%s»"

msgid ""
"Key already saved: %(hint)s (in %(where)s). Entering a new key will "
"overwrite it."
msgstr "כבר נשמר מפתח: %(hint)s (ב־%(where)s). הזנת מפתח חדש תחליף אותו."

msgid ""
"Could not launch web browser. Please open this URL manually:\n"
"%s"
msgstr ""
"לא ניתן היה לשגר דפדפן. יש לפתוח את הכתובת הזו ידנית:\n"
"‪%s‬"

msgid "Key saved in %s (encrypted via system keyring)."
msgstr "המפתח נשמר ב־%s (מוצפן באמצעות מחזיק המפתחות של המערכת)."

msgid ""
"No system keyring detected; key saved unencrypted in %s. Do not copy or sync"
" this folder."
msgstr ""
"לא נמצא מחזיק מפתחות של המערכת; המפתח נשמר ללא הצפנה ב־‪%s‬. אין להעתיק או "
"לסנכרן את התיקיה הזו."

msgid "requires configuration:"
msgstr "דורש הגדרה:"

msgid "The saved key has been removed."
msgstr "המפתח השמור הוסר."

msgid "Select an event."
msgstr "יש לבחור אירוע."

msgid "Select a place."
msgstr "יש לבחור מקום."

msgid "Open Place Completer with this event's place and date"
msgstr "פתיחת השלמת מדרג מקומות עם המקום והתאריך של האירוע הזה"

msgid "Complete place data…"
msgstr "השלמת נתוני מקום…"

msgid "%(type)s, %(date)s"
msgstr "%(type)s, %(date)s"

msgid "This event has no place assigned."
msgstr "לאירוע הזה לא הוגדר מקום."

msgid "Names are missing for this date (place displayed with «?»)"
msgstr "חסרים שמות לתאריך הזה (במקום מופיע «?»)"

msgid "Place Completer window is already open."
msgstr "חלון השלמת מדרג מקומות כבר פתוח."

msgid "Gramps currently displays: %s"
msgstr "גרמפס מציג כעת: %s"

msgid "Missing data: %s"
msgstr "נתונים חסרים: %s"

msgid "no valid date"
msgstr "אין תאריך תקין"

msgid "(no name)"
msgstr "(ללא שם)"

msgid "Place Completer opened for this place: specify a date and click Ask."
msgstr ""
"השלמת מדרג מקומות נפתחה עבור המקום הזה: יש להזין תאריך ולהקיש על ״שליחה״."

msgid "Reported by an AI search"
msgstr "דווח על ידי חיפוש בבינה מלאכותית"

msgid ""
"Found by %(engine)s (%(model)s) on %(day)s, responding to query regarding "
"«%(place)s» on %(date)s (query format: %(form)s)."
msgstr ""
"נמצא על ידי %(engine)s (%(model)s) ב־%(day)s, בתשובה לשאלה בנוגע "
"ל־«%(place)s» ב־%(date)s (תסדיר השאלה: %(form)s)."

msgid "Wikidata statement"
msgstr "הצהרת ‪Wikidata‬"

msgid "Reported by AI search supporting: %s"
msgstr "דווח על ידי חיפוש בבינה מלאכותית שתומך ב־%s"

msgid "Retrieved from Wikidata on %(day)s while completing «%(place)s»."
msgstr "נלקח מ־‪Wikidata‬ ב־%(day)s בעת השלמת «%(place)s»."

msgid "Saved response: %s"
msgstr "תשובה שמורה: %s"

msgid "The response indicates uncertainty regarding: %s"
msgstr "התשובה מציינת אי־ודאות לגבי: %s"

msgid "Gemini (query copied to clipboard: paste into the browser prompt)"
msgstr ""
"‪Gemini‬ (השאלה הועתקה ללוח־הגזירים: יש להדביק אותה בשורת ההנחיה בדפדפן)"

msgid ""
". Destination unreachable: the local model server (e.g. Ollama) is either "
"not installed or not currently running"
msgstr ""
". היעד אינו נגיש: שרת המודלים המקומי (לדוגמה ‪Ollama‬) אינו מותקן או אינו "
"פועל כעת"

msgid "start the local model server daemon, or update base_url in %s"
msgstr "יש להפעיל את תהליך שרת המודלים המקומי, או לעדכן את ‪base_url‬ ב־‪%s‬"

msgid ". Target model missing: download using 'ollama pull %s'"
msgstr ". המודל היעד חסר: יש להורידו באמצעות ‪'ollama pull %s'‬"

msgid "primary name"
msgstr "שם ראשי"

msgid "alternative name #%d"
msgstr "שם חלופי מס׳ %d"

msgid "unspecified language"
msgstr "שפה לא מצוינת"

msgid "language: %s"
msgstr "שפה: %s"

msgid "Ollama is not installed"
msgstr "‪Ollama‬ אינו מותקן"

msgid "Download"
msgstr "הורדה"

msgid "another model name (optional)"
msgstr "שם מודל אחר (לא חובה)"

msgid "Command copied: open a terminal and paste it (Ctrl+Shift+V)."
msgstr "הפקודה הועתקה: יש לפתוח מסוף ולהדביק אותה (‪Ctrl+Shift+V‬)."

msgid "Download a model"
msgstr "הורדת מודל"

msgid "Starting download…"
msgstr "תחילת ההורדה…"

msgid "download cancelled"
msgstr "ההורדה בוטלה"

msgid "Starting Ollama…"
msgstr "הפעלת ‪Ollama‬…"

msgid "Copy command"
msgstr "העתקת הפקודה"

msgid "Open terminal to run installer"
msgstr "פתיחת מסוף להרצת ההתקנה"

msgid "Downloading %s"
msgstr "הורדת %s"

msgid "Ollama service is not running"
msgstr "שירות ‪Ollama‬ אינו פועל"

msgid "Downloading model %s…"
msgstr "הורדת המודל %s…"

msgid "Model %s successfully installed."
msgstr "המודל %s הותקן בהצלחה."

msgid ""
"A terminal window is open: enter your administrator password there. Once "
"installation finishes, click Ask again."
msgstr ""
"נפתח חלון מסוף: יש להזין בו את ססמת המנהל. עם סיום ההתקנה, יש להקיש שוב על "
"״שליחה״."

msgid "Downloading…"
msgstr "הורדה…"

msgid ""
"To start manually via terminal run:  ollama serve   (or:  sudo systemctl "
"start ollama )"
msgstr ""
"להפעלה ידנית במסוף:  ‪ollama serve‬   (או:  ‪sudo systemctl start ollama‬ )"

msgid "Start service"
msgstr "הפעלת השירות"

msgid ""
"Ollama service is active but has no models installed. Run 'ollama pull "
"llama3.2' in terminal and try again"
msgstr ""
"שירות ‪Ollama‬ פעיל אך לא הותקנו בו מודלים. יש להריץ במסוף ‪ollama pull "
"llama3.2‬ ולנסות שוב"

msgid ""
"Ollama is not active locally. Click Ask to run guided setup. Manual steps: "
"1) Install from ollama.com; 2) Start service with 'ollama serve'; 3) "
"Download model using 'ollama pull llama3.2'."
msgstr ""
"‪Ollama‬ אינו פעיל במחשב זה. יש להקיש על ״שליחה״ להפעלת ההגדרה המודרכת. "
"שלבים ידניים: 1) התקנה מ־‪ollama.com‬; 2) הפעלת השירות באמצעות ‪'ollama "
"serve'‬; 3) הורדת מודל באמצעות ‪'ollama pull llama3.2'‬."

msgid "download terminated prematurely"
msgstr "ההורדה הסתיימה בטרם עת"

msgid "Ollama launched but is not responding yet; check logs in %s"
msgstr "‪Ollama‬ שוגר אך עדיין אינו מגיב; יש לבדוק את היומנים ב־‪%s‬"

msgid ""
"Terminal application not detected. Copy command and execute manually in "
"system terminal."
msgstr ""
"לא נמצא יישום מסוף. יש להעתיק את הפקודה ולהריץ אותה ידנית במסוף המערכת."

msgid "Failed to launch Ollama: %s"
msgstr "שיגור ‪Ollama‬ נכשל: %s"

msgid "download process interrupted: %s"
msgstr "תהליך ההורדה הופסק: %s"

msgid "Could not launch terminal application: %s"
msgstr "לא ניתן היה לשגר את יישום המסוף: %s"

msgid "small and fast (~2 GB, recommended)"
msgstr "קטן ומהיר (כ־‪2 GB‬, מומלץ)"

msgid "ultra-compact: faster response, reduced accuracy"
msgstr "קומפקטי במיוחד: תשובה מהירה יותר, דיוק מופחת"

msgid "Google model family (~a few GB)"
msgstr "משפחת מודלים של ‪Google‬ (כמה ‪GB‬)"

msgid "general-purpose model (~a few GB)"
msgstr "מודל כללי (כמה ‪GB‬)"

msgid "Very Low"
msgstr "נמוך מאוד"

msgid "Low"
msgstr "נמוך"

msgid "Normal"
msgstr "סדיר"

msgid "Confidence level %(level)s: %(why)s."
msgstr "רמת ודאות %(level)s: %(why)s."

msgid "a Wikidata statement"
msgstr "הצהרת ‪Wikidata‬"

msgid "the response does not specify which fields this page supports"
msgstr "התשובה אינה מציינת אילו שדות העמוד הזה תומך בהם"

msgid ""
"downgraded one confidence level due to internal contradictions or "
"discrepancies with saved responses"
msgstr "הורדה רמת ודאות אחת עקב סתירות פנימיות או אי־התאמות לתשובות שמורות"

msgid ""
"the response expresses uncertainty regarding all claims cited on this page: "
"%s"
msgstr "התשובה מביעה אי־ודאות לגבי כל הטענות שהעמוד הזה מצוטט בגינן: %s"

msgid "the response expresses uncertainty regarding part of this claim: %s"
msgstr "התשובה מביעה אי־ודאות לגבי חלק מהטענה הזו: %s"

msgid "the response cites this page for %s without expressing uncertainty"
msgstr "התשובה מצטטת את העמוד הזה בגין %s בלי להביע אי־ודאות"

msgid "no response from host %s:%d"
msgstr "אין תגובה מהמארח ‪%s:%d‬"

msgid ""
"Query for «%s» on %s copied and %s launched. Paste query (Ctrl+V) and "
"submit; once completed, copy full response back here and click Analyze."
msgstr ""
"השאלה בנוגע ל־«%s» ב־%s הועתקה, ו־%s שוגר. יש להדביק את השאלה (‪Ctrl+V‬) "
"ולשלוח אותה; עם השלמת התשובה יש להעתיק אותה במלואה חזרה לכאן ולהקיש על "
"״ניתוח״."

msgid "Google AI mode"
msgstr "‪Google AI mode‬"

msgid "ChatGPT (web search enabled)"
msgstr "‪ChatGPT‬ (חיפוש מרשתת מופעל)"

msgid ""
"Custom AI: query is copied; paste into your AI tool and paste the response "
"back here"
msgstr ""
"בינה מלאכותית אחרת: השאלה מועתקת; יש להדביק אותה בכלי הבינה המלאכותית "
"ולהדביק את התשובה חזרה כאן"

msgid "Claude API with web search"
msgstr "‪Claude API‬ עם חיפוש מרשתת"

msgid "OpenAI-compatible endpoint (without internal web search)"
msgstr "נקודת קצה תואמת ‪OpenAI‬ (ללא חיפוש מרשתת פנימי)"

msgid "Local Ollama instance (no internet access)"
msgstr "‪Ollama‬ מקומי (ללא גישה למרשתת)"

msgid "no key required"
msgstr "אין צורך במפתח"

msgid "configured, %d characters"
msgstr "הוגדר, %d תווים"

msgid ""
"contains leading/trailing whitespace or line breaks (automatically trimmed)"
msgstr "מכיל רווחים או שבירות שורה בתחילתו או בסופו (מוסרים אוטומטית)"

msgid "enclosed in quotation marks (automatically stripped)"
msgstr "עטוף במרכאות (מוסרות אוטומטית)"

msgid ""
"contains internal spaces or line breaks: clipboard data might be corrupted"
msgstr "מכיל רווחים או שבירות שורה בתוכו: ייתכן שהנתונים בלוח־הגזירים פגומים"

msgid ""
"contains non-ASCII characters (check for formatting marks or localized "
"keyboard input)"
msgstr ""
"מכיל תווים שאינם ‪ASCII‬ (יש לבדוק אם נוספו סימני עיצוב או הוזן קלט ממקלדת "
"מותאמת שפה)"

msgid "invalid Anthropic API key format (must begin with 'sk-ant-')"
msgstr "תסדיר מפתח ‪API‬ של ‪Anthropic‬ אינו תקין (חייב להתחיל ב־‪'sk-ant-'‬)"

msgid ""
"This is an Anthropic Claude key, but the engine sends requests to %s. Please"
" select 'Claude API with web search' from the engine list."
msgstr ""
"זה מפתח ‪Claude‬ של ‪Anthropic‬, אך המנוע שולח בקשות אל ‪%s‬. יש לבחור "
"ברשימת המנועים את ״‪Claude API‬ עם חיפוש מרשתת״."

msgid ""
"Anthropic API keys must start with 'sk-ant-'. The provided key appears "
"invalid or belongs to a different provider. It will be sent to %s."
msgstr ""
"מפתחות ‪API‬ של ‪Anthropic‬ חייבים להתחיל ב־‪'sk-ant-'‬. המפתח שסופק נראה לא"
" תקין או שייך לספק אחר. הוא יישלח אל ‪%s‬."

msgid "API key in %s: MISSING%s"
msgstr "מפתח ‪API‬ ב־%s: חסר%s"

msgid "No API key available to test."
msgstr "אין מפתח ‪API‬ לבדיקה."

msgid "API key validated successfully%s."
msgstr "מפתח ‪API‬ אומת בהצלחה%s."

msgid "the response is empty"
msgstr "התשובה ריקה"

msgid ""
"key file %s has insecure permissions (readable by others). Execute: chmod "
"600 %s"
msgstr ""
"לקובץ המפתח ‪%s‬ הרשאות לא בטוחות (קריא לאחרים). יש להריץ: ‪chmod 600 %s‬"

msgid ""
"API key missing. Enter it via the Key button (stored securely in keyring or "
"restricted user file), or %s specify key_file in %s."
msgstr ""
"מפתח ‪API‬ חסר. יש להזין אותו באמצעות הלחצן ״מפתח…״ (נשמר באופן מאובטח "
"במחזיק המפתחות או בקובץ משתמש מוגבל), או %s לציין ‪key_file‬ ב־‪%s‬."

msgid "This engine does not use an API key."
msgstr "המנוע הזה אינו משתמש במפתח ‪API‬."

msgid "response returned empty content (stop reason: %s)"
msgstr "התשובה חזרה ללא תוכן (סיבת העצירה: %s)"

msgid ""
"this engine requires a model specification. Define it in %s, e.g.: "
"{\"engines\": {\"%s\": {\"model\": \"model-name\"}}}"
msgstr ""
"המנוע הזה מחייב ציון מודל. יש להגדיר אותו ב־‪%s‬, לדוגמה: ‪{\"engines\": "
"{\"%s\": {\"model\": \"model-name\"}}}‬"

msgid "response structure is invalid or unrecognized"
msgstr "מבנה התשובה אינו תקין או אינו מזוהה"

msgid "service returned HTTP error %s: %s"
msgstr "השירות החזיר שגיאת ‪HTTP %s‬: %s"

msgid "cannot connect to %s: %s"
msgstr "לא ניתן להתחבר אל ‪%s‬: %s"

msgid "key file permissions are insecure (readable by others)"
msgstr "הרשאות קובץ המפתח אינן בטוחות (קריא לאחרים)"

msgid "unable to read key file"
msgstr "לא ניתן לקרוא את קובץ המפתח"

msgid "; model %s is active"
msgstr "; המודל %s פעיל"

msgid ""
"use the Key button to store your credential%s, or specify key_file in %s"
msgstr "יש להשתמש בלחצן ״מפתח…״ לשמירת המפתח%s, או לציין ‪key_file‬ ב־‪%s‬"

msgid ""
"Service %s rejected the API key (HTTP %d). Sent key suffix: %s. Verify key "
"validity, quota limits, and provider matching."
msgstr ""
